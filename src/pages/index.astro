    .exp-item .period { color: var(--muted); font-size: 0.85rem; }
    .exp-item p { color: var(--muted); margin-top: 6px; font-size: 0.95rem; }
    footer { padding: 40px 0 80px; color: var(--muted); font-size: 0.9rem; }
