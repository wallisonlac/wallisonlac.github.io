<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Wallison Campanelli — Senior Data Engineer & ML Engineer</title>
  <meta name="description" content="Senior Data Engineer & ML Engineer. Azure, Databricks, Snowflake, PySpark, MLOps, Power BI. PhD in Physics (CERN/LIP). Open to remote B2B contracts." />
  <style>
    :root {
      --bg: #0b0e11;
      --bg-card: #12161b;
      --border: #22282f;
      --text: #e7e9ea;
      --text-dim: #9aa4ad;
      --accent: #2dd4bf;
      --accent-dim: #1a4a44;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      line-height: 1.6;
    }
    .container { max-width: 920px; margin: 0 auto; padding: 64px 24px 96px; }
    .eyebrow { color: var(--accent); font-weight: 600; font-size: 0.95rem; letter-spacing: 0.02em; }
    h1 { font-size: 2.6rem; margin: 8px 0 4px; font-weight: 800; }
    .subtitle { color: var(--text-dim); font-size: 1.05rem; margin-bottom: 24px; }
    .links { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 40px; }
    .links a {
      color: var(--text); text-decoration: none; border: 1px solid var(--border);
      padding: 8px 18px; border-radius: 8px; font-size: 0.92rem; transition: border-color 0.15s;
    }
    .links a:hover { border-color: var(--accent); color: var(--accent); }
    hr { border: none; border-top: 1px solid var(--border); margin: 40px 0; }
    h2 { font-size: 1.6rem; font-weight: 700; margin-bottom: 18px; }
    h3.sub { font-size: 1.02rem; font-weight: 700; margin: 22px 0 8px; color: var(--text); }
    p { color: var(--text-dim); }
    .lead { color: var(--text-dim); font-size: 1.02rem; max-width: 760px; }
    ul.clean { margin: 0; padding-left: 20px; }
    ul.clean li { color: var(--text-dim); font-size: 0.93rem; margin-bottom: 6px; }

    .tracks { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 8px; }
    @media (max-width: 700px) { .tracks { grid-template-columns: 1fr; } }
    .track { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 20px 22px; }
    .track .tag {
      display: inline-block; color: var(--accent); background: var(--accent-dim);
      font-size: 0.72rem; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase;
      padding: 3px 9px; border-radius: 5px; margin-bottom: 10px;
    }
    .track h3 { font-size: 1.12rem; margin: 0 0 8px; font-weight: 700; }
    .track p { font-size: 0.92rem; margin: 0 0 10px; color: var(--text-dim); }
    .track .stack {
      font-size: 0.82rem; color: var(--text-dim); border-top: 1px solid var(--border);
      padding-top: 10px; margin-top: 10px;
    }
    .track .stack b { color: var(--text); font-weight: 600; }

    .exp-item { margin-bottom: 26px; }
    .exp-item .role { font-weight: 700; font-size: 1.05rem; color: var(--text); }
    .exp-item .meta { color: var(--accent); font-size: 0.85rem; margin-bottom: 8px; }
    .exp-item ul.clean li { font-size: 0.92rem; }

    .skills-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; margin-top: 4px; }
    @media (max-width: 700px) { .skills-grid { grid-template-columns: 1fr; } }
    .skill-row { font-size: 0.9rem; padding: 8px 0; border-bottom: 1px solid var(--border); }
    .skill-row b { color: var(--text); font-weight: 600; margin-right: 6px; }
    .skill-row span { color: var(--text-dim); }

    .avail-box { background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px; padding: 22px 26px; }
    .avail-box ul.clean li { font-size: 0.93rem; }

    .contact-box {
      background: var(--bg-card); border: 1px solid var(--border); border-radius: 12px;
      padding: 28px; text-align: center;
    }
    .contact-box p { margin-bottom: 18px; }
    .cta {
      display: inline-block; background: var(--accent); color: #06201c; font-weight: 700;
      padding: 10px 24px; border-radius: 8px; text-decoration: none; font-size: 0.95rem;
    }
    footer { text-align: center; color: var(--text-dim); font-size: 0.82rem; margin-top: 56px; }
  </style>
</head>
