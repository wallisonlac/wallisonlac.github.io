    .card h3 a:hover { color: var(--accent); }
    .card p { color: var(--muted); margin: 0 0 12px; font-size: 0.95rem; }
    .tags span {
      display: inline-block;
      background: #1a2230;
      color: var(--accent);
      font-size: 0.75rem;
      padding: 4px 10px;
      border-radius: 6px;
      margin-right: 6px;
    }
    .exp-item { margin-bottom: 24px; }
